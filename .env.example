# BranchlessPay
BP_LICENSE_KEY=bp_test_YOUR_TOKEN_HERE
BP_API_URL=https://branchlesspay.com/api/v1/anchor

# FreshBooks OAuth (from developer.freshbooks.com app)
FRESHBOOKS_CLIENT_ID=
FRESHBOOKS_CLIENT_SECRET=
# Must match Redirect URI in FreshBooks Developer app exactly:
FRESHBOOKS_REDIRECT_URI=https://branchlesspay.com/connect/freshbooks/callback
# Local dev only (register separately in Developer Portal if needed):
# FRESHBOOKS_REDIRECT_URI=http://localhost:8765/oauth/callback
FRESHBOOKS_ACCESS_TOKEN=
FRESHBOOKS_REFRESH_TOKEN=
FRESHBOOKS_ACCOUNT_ID=

# Webhook verifier secret (from FreshBooks callback registration response)
FRESHBOOKS_WEBHOOK_VERIFIER=

# Server
HOST=127.0.0.1
PORT=8080

# Local dev only — never enable in production
FRESHBOOKS_SKIP_SIGNATURE_VERIFY=0
